# Todo Frontend - Environment Variables Template
# Copy to .env.local and fill with real values. NEVER commit .env.local.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth secret used by Better Auth client
NEXT_PUBLIC_BETTER_AUTH_SECRET=""

# Google Gemini API key (client-side use only; NEXT_PUBLIC_ vars are public)
NEXT_PUBLIC_GEMINI_API_KEY=""
